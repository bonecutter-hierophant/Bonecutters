{
  "name": "bonecutters",
  "version": "0.1.0",
  "private": true,
  "description": "Public Bonecutters business-card website.",
  "type": "module",
  "scripts": {
    "deps:client": "npm --prefix client ci",
    "deps:all": "npm run deps:client",
    "verify:dependency-layout": "node tools/check-dependency-layout.mjs",
    "verify:public-sanitization": "node tools/check-public-sanitization.mjs",
    "verify:test": "node tools/test-client.mjs",
    "verify:client:typecheck": "npm --prefix client run typecheck",
    "verify:client": "npm --prefix client run build",
    "verify:docs": "node tools/check-docs-whitespace.mjs",
    "verify:deployment-config": "node tools/test-deployment-config.mjs",
    "verify:scoped": "node tools/run-verification.mjs",
    "verify:safe": "node tools/run-verification.mjs preset:safe",
    "verify:list": "node tools/run-verification.mjs --list",
    "verify:recommend:dirty": "node tools/run-verification.mjs --recommend --dirty",
    "deploy:check": "node tools/validate-deployment-config.mjs",
    "deploy:validate": "node tools/validate-deployment-config.mjs --strict",
    "deploy:aws": "node tools/deploy-aws.mjs",
    "aws:lane": "node tools/aws-lane.mjs",
    "dev": "npm --prefix client run dev --",
    "build": "npm --prefix client run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bonecutter-hierophant/Bonecutters.git"
  },
  "keywords": [
    "bonecutters",
    "static-site",
    "vite",
    "react"
  ],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/bonecutter-hierophant/Bonecutters/issues"
  },
  "homepage": "https://bonecutters.us"
}
